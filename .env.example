# URL publique de déploiement (sans slash final) pour les balises Open Graph, canonical et sitemap
# Exemple : https://ikramraboudi.vercel.app ou https://ikramraboudi.github.io/Portfolio
VITE_SITE_URL=

# Base path pour le déploiement (laisser vide ou '/' pour Vercel, '/Portfolio/' pour GitHub Pages)
VITE_BASE_PATH=/

# ID de formulaire Formspree (gratuit sur https://formspree.io)
# Si cette variable n'est pas renseignée, le formulaire bascule automatiquement sur un mailto: pré-rempli.
VITE_FORMSPREE_ID=
